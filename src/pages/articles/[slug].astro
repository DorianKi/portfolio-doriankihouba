---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import site from '../../content/site.json';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.publie);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const date = article.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base titre={`${article.data.titre} · ${site.nom}`} description={article.data.description} type="article">
  <article class="section">
    <div class="inner texte">
      <p class="kicker"><span class="n">Article</span><span>{date}</span></p>
      <h1 class="h-chap">{article.data.titre}</h1>
      <p class="lede">{article.data.description}</p>
      <div class="corps"><Content /></div>
      <p class="retour"><a href="/#ch4">← Retour au chapitre 4</a></p>
    </div>
  </article>
</Base>

<style>
  .texte { max-width: 760px; }
  .corps { margin-top: 40px; font-size: 18px; line-height: 1.7; }
  .corps :global(h2) { font-size: 28px; font-stretch: 88%; margin: 40px 0 10px; }
  .corps :global(p) { margin: 0 0 16px; }
  .corps :global(hr) { border: 0; border-top: 2px solid var(--encre); margin: 40px 0; }
  .retour { margin-top: 48px; font-family: var(--mono); font-size: 14px; }
  .retour a { color: var(--orange-texte); text-underline-offset: 3px; }
</style>

---
import { getCollection } from 'astro:content';
const chiffres = (await getCollection('chiffres')).sort((a, b) => a.data.ordre - b.data.ordre);
const projets = (await getCollection('projets', ({ data }) => data.publie)).sort((a, b) => a.data.ordre - b.data.ordre);
---
<section class="section" aria-labelledby="t-chiffres">
  <div class="inner">
    <p class="kicker"><span class="n">00</span><span>Chiffres clés</span></p>
    <h2 class="h-chap" id="t-chiffres">L'essentiel en une page</h2>
    <dl class="chiffres">
      {chiffres.map((c) => (
        <div class="chiffre">
          <dt class="sr-only">{c.data.libelle}</dt>
          <dd><span class="v">{c.data.valeur}</span><span class="l">{c.data.libelle}{c.data.note && <sup>{c.data.note}</sup>}</span></dd>
        </div>
      ))}
    </dl>
    <div class="une">
      {projets.map((p, i) => (
        <a href={`#cas-${p.id}`}>
          <span class="ref">Cas 3.{i + 1} · {p.data.organisation}</span>
          <span class={`mini mini-${p.data.demo}`} aria-hidden="true"></span>
          <h3>{p.data.titre}</h3>
          <p>{p.data.resume}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .chiffres { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 36px 0 0; border-top: 2px solid var(--encre); }
  @media (max-width: 820px) { .chiffres { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .chiffre { padding: 18px 16px 20px 0; border-bottom: 1px solid var(--filet); }
  .chiffre + .chiffre { padding-left: 16px; border-left: 1px solid var(--filet); }
  @media (max-width: 820px) { .chiffre:nth-child(odd) { border-left: 0; padding-left: 0; } }
  dd { margin: 0; display: grid; gap: 6px; }
  .v { font-family: var(--display); font-stretch: 70%; font-weight: 700; font-size: clamp(44px, 5vw, 68px); line-height: 1; font-variant-numeric: tabular-nums; }
  .l { font-size: 14px; color: var(--encre-2); }
  .une { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 40px; border-top: 1px solid var(--encre); }
  @media (max-width: 820px) { .une { grid-template-columns: minmax(0, 1fr); } }
  .une a { padding: 16px 16px 20px 0; text-decoration: none; display: grid; gap: 8px; border-bottom: 1px solid var(--filet); align-content: start; }
  .une a + a { padding-left: 16px; border-left: 1px solid var(--filet); }
  @media (max-width: 820px) { .une a + a { padding-left: 0; border-left: 0; } }
  .ref { font-family: var(--mono); font-size: 12px; color: var(--orange-texte); }
  h3 { font-size: 22px; font-stretch: 90%; }
  .une a:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
  .une p { font-size: 14px; color: var(--encre-2); }
  /* Aperçus abstraits des trois tableaux de bord */
  .mini { height: 60px; background: var(--nuit); display: block; background-repeat: no-repeat; }
  .mini-orange { background-image: linear-gradient(#3987e5, #3987e5), linear-gradient(#3987e5, #3987e5), linear-gradient(#3987e5, #3987e5), linear-gradient(#3987e5, #3987e5), linear-gradient(#FF6B3D, #FF6B3D); background-size: 10% 50%, 10% 64%, 10% 40%, 10% 70%, 18% 4px; background-position: 12% 85%, 30% 85%, 48% 85%, 66% 85%, 8% 18%; }
  .mini-bolt { background-image: linear-gradient(#3987e5, #3987e5), linear-gradient(#d95926, #d95926), linear-gradient(#199e70, #199e70), linear-gradient(#d55181, #d55181); background-size: 40% 70%, 20% 34%, 20% 34%, 18% 70%; background-position: 6% 50%, 50% 15%, 50% 85%, 78% 50%; }
  .mini-alternants { background-image: radial-gradient(circle, #FF6B3D 0 9px, transparent 10px), radial-gradient(circle, #FF6B3D 0 6px, transparent 7px), radial-gradient(circle, #FF6B3D 0 4px, transparent 5px), linear-gradient(#FF6B3D, #FF6B3D), linear-gradient(#FF6B3D, #FF6B3D); background-size: 30px 30px, 20px 20px, 14px 14px, 26% 6px, 16% 6px; background-position: 70% 55%, 52% 35%, 84% 25%, 8% 30%, 8% 60%; }
</style>

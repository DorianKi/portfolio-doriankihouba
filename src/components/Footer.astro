---
import site from '../content/site.json';
const annee = new Date().getFullYear();
---
<footer class="pied dark">
  <div class="inner">
    <span>© {annee} {site.nom}</span>
    <span><a href="/mentions-legales">Mentions légales</a> · Site sans cookie</span>
    <span>Édition {site.edition}</span>
  </div>
</footer>

<style>
  .pied { border-top: 1px solid var(--bleu); }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; padding-block: 16px calc(16px + env(safe-area-inset-bottom, 0px)); font-family: var(--mono); font-size: 12px; color: var(--brume); }
  a { text-underline-offset: 3px; }
  a:hover { color: var(--blanc); }
</style>

---
import { getCollection } from 'astro:content';
const passions = (await getCollection('passions')).sort((a, b) => a.data.ordre - b.data.ordre);
const af = (await getCollection('assessfirst')).sort((a, b) => a.data.ordre - b.data.ordre);
const dimensions = af.filter((a) => a.data.type === 'dimension');
const forces = af.filter((a) => a.data.type === 'force');
---
<section class="section" id="ch4" aria-labelledby="t-ch4">
  <div class="inner">
    <p class="kicker"><span class="n">04</span><span>Chapitre 4</span></p>
    <h2 class="h-chap" id="t-ch4">En dehors du bureau</h2>
    <p class="lede">Gardien de but sur le terrain, gardien de la qualité des données au bureau.</p>

    <div class="hors">
      {passions.map((p) => (
        <div>
          <h3>{p.data.titre}</h3>
          <dl class="feuille">
            {p.data.fiche.map((f) => <div><dt>{f.cle}</dt><dd>{f.valeur}</dd></div>)}
          </dl>
          {p.data.phrase && <p>{p.data.phrase}</p>}
          <h4>{p.data.sousTitre}</h4>
          <ul class="lecons">
            {p.data.lecons.map((l) => <li><b>{l.titre}</b> {l.texte}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="profil">
      <h3>Ce que dit mon profil AssessFirst</h3>
      <div class="scroll-x">
        <table class="tableau">
          <caption class="sr-only">Résultats du questionnaire AssessFirst</caption>
          <thead><tr><th scope="col">Dimension</th><th scope="col">Résultat</th><th scope="col">En clair</th></tr></thead>
          <tbody>
            {dimensions.map((d) => <tr><td>{d.data.dimension}</td><td><strong>{d.data.resultat}</strong></td><td>{d.data.enClair}</td></tr>)}
          </tbody>
        </table>
      </div>
      <div class="forces">
        {forces.map((f) => <div class="force"><q>{f.data.citation}</q><p>{f.data.exemple}</p></div>)}
      </div>
      <p class="mention">Source : rapport AssessFirst (SWIPE, DRIVE, BRAIN) du 23/09/2026. Les forces sont citées mot pour mot.</p>
    </div>

    <a class="article-link" href="/articles/sport-et-data"><b>Ce que le sport m'apprend sur la data</b><span>Lire l'article →</span></a>
  </div>
</section>

<style>
  .hors { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); margin-top: 36px; border-top: 2px solid var(--encre); }
  @media (max-width: 820px) { .hors { grid-template-columns: minmax(0, 1fr); } }
  .hors > div { padding: 20px 24px 24px 0; border-bottom: 1px solid var(--filet); display: grid; gap: 12px; align-content: start; }
  .hors > div + div { padding-left: 24px; border-left: 1px solid var(--filet); }
  @media (max-width: 820px) { .hors > div + div { padding-left: 0; border-left: 0; } }
  .hors h3 { font-size: 30px; font-stretch: 80%; text-transform: uppercase; }
  .feuille { font-family: var(--mono); font-size: 13px; margin: 0; }
  .feuille div { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px dashed var(--filet); padding-block: 6px; }
  .feuille dt { color: var(--encre-2); }
  .feuille dd { margin: 0; text-align: right; }
  h4 { font-family: var(--mono); font-weight: 500; font-size: 12px; color: var(--orange-texte); margin-top: 8px; }
  .lecons { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; font-size: 15px; }
  .lecons li { border-top: 1px solid var(--filet); padding-top: 8px; }
  .lecons b { font-family: var(--display); font-stretch: 95%; }
  .profil { margin-top: 56px; }
  .profil h3 { font-size: 26px; font-stretch: 90%; }
  .profil .tableau { margin-top: 16px; }
  .forces { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 24px; border-top: 1px solid var(--encre); }
  @media (max-width: 820px) { .forces { grid-template-columns: minmax(0, 1fr); } }
  .force { padding: 16px 16px 18px 0; display: grid; gap: 8px; border-bottom: 1px solid var(--filet); align-content: start; }
  .force + .force { padding-left: 16px; border-left: 1px solid var(--filet); }
  @media (max-width: 820px) { .force + .force { padding-left: 0; border-left: 0; } }
  q { font-family: var(--display); font-stretch: 90%; font-size: 19px; font-weight: 600; quotes: "« " " »"; }
  .force p { font-size: 14px; color: var(--encre-2); }
  .mention { font-family: var(--mono); font-size: 12px; color: var(--encre-2); margin-top: 12px; }
  .article-link { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 48px; padding: 22px 0; border-top: 2px solid var(--encre); border-bottom: 2px solid var(--encre); text-decoration: none; }
  .article-link b { font-family: var(--display); font-stretch: 85%; font-size: clamp(22px, 3vw, 34px); }
  .article-link span { font-family: var(--mono); font-size: 13px; color: var(--orange-texte); }
  .article-link:hover b { text-decoration: underline; text-underline-offset: 5px; }
</style>

---
import { Picture } from 'astro:assets';
import portrait from '../assets/dorian-portrait.png';
import site from '../content/site.json';

const sommaire = [
  { n: '01', href: '#ch1', titre: 'Les bases business', info: '2018 → 2023' },
  { n: '02', href: '#ch2', titre: 'Le virage data', info: '2023 → 2026' },
  { n: '03', href: '#ch3', titre: 'Études de cas', info: '3 projets' },
  { n: '04', href: '#ch4', titre: 'En dehors du bureau', info: 'futsal · JJB' },
];
---
<section class="couverture dark" aria-labelledby="titre-site">
  <div class="inner">
    <div class="meta">
      <span><b>Rapport d'activité</b>Exercices 2018 → 2026</span>
      <span><b>{site.nom}</b>{site.ville}, France</span>
      <span><b>Data Analyst</b>Consultant BI</span>
      <span><b>Édition</b>{site.edition}</span>
    </div>
    <div class="grille">
      <div>
        <h1 class="titre" id="titre-site" aria-label="Business × Data">
          <span class="w w1" aria-hidden="true">Business</span>
          <span class="w w2" aria-hidden="true"><span class="x">×</span>Data</span>
        </h1>
        <p class="poste">{site.poste} <span>· {site.ville}</span></p>
        <p class="dispo">{site.disponibilite}</p>
        <p class="accroche">{site.accroche}</p>
        <div class="actions">
          <a class="btn primary" href={site.linkedin} rel="noopener" target="_blank">Me contacter sur LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="btn ghost" href={site.cv} download>Télécharger mon CV</a>
        </div>
        <p class="outils"><b>{site.outils}</b> · {site.langues}</p>
      </div>
      <figure class="portrait">
        <Picture src={portrait} formats={['avif', 'webp']} widths={[300, 433]} sizes="(max-width: 980px) 72vw, 300px" alt="Portrait de Dorian Kihouba" loading="eager" fetchpriority="high" />
        <figcaption>L'auteur du rapport · {site.ville}, 2026</figcaption>
        <nav class="sommaire" aria-label="Sommaire">
          {sommaire.map((s) => (
            <a href={s.href}><span>{s.n}</span><span>{s.titre}</span><span>{s.info}</span></a>
          ))}
        </nav>
      </figure>
    </div>
  </div>
</section>

<style>
  .inner { padding-block: 28px 64px; }
  .meta {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px;
    border-top: 1px solid var(--bleu); border-bottom: 1px solid var(--bleu); padding-block: 10px;
    font-family: var(--mono); font-size: 12px; color: var(--brume); margin-bottom: 40px;
  }
  .meta b { display: block; color: var(--blanc); font-weight: 500; }
  @media (max-width: 700px) { .meta { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .grille { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 48px; align-items: end; }
  @media (max-width: 980px) { .grille { grid-template-columns: minmax(0, 1fr); gap: 36px; } }
  .titre { font-weight: 800; line-height: .86; letter-spacing: -.02em; font-size: clamp(58px, 11vw, 160px); text-transform: uppercase; }
  .w { display: block; }
  .w1 { font-stretch: 62%; }
  .w2 { font-stretch: 125%; }
  .x { color: var(--orange); font-stretch: 100%; font-weight: 300; display: inline-block; margin-right: .08em; }
  @media (prefers-reduced-motion: no-preference) {
    .w1 { animation: serre 1.6s cubic-bezier(.2, .7, .2, 1) backwards; }
    .w2 { animation: elargit 1.6s cubic-bezier(.2, .7, .2, 1) backwards; }
    .x { animation: tourne 1.6s cubic-bezier(.2, .7, .2, 1) .2s backwards; }
  }
  @keyframes serre { from { font-stretch: 125%; } to { font-stretch: 62%; } }
  @keyframes elargit { from { font-stretch: 62%; } to { font-stretch: 125%; } }
  @keyframes tourne { from { transform: rotate(-90deg); } to { transform: rotate(0); } }
  .poste { font-family: var(--display); font-size: clamp(20px, 2.4vw, 28px); font-weight: 600; margin-top: 22px; }
  .poste span { color: var(--brume); font-weight: 400; }
  .dispo { font-family: var(--mono); font-size: 13px; margin-top: 10px; }
  .dispo::before { content: "■ "; color: var(--orange); }
  .accroche { font-size: clamp(18px, 1.8vw, 21px); max-width: 44ch; margin-top: 26px; }
  .actions { margin-top: 26px; }
  .outils { margin-top: 26px; font-family: var(--mono); font-size: 13px; color: var(--brume); }
  .outils b { color: var(--blanc); font-weight: 500; }
  .portrait { display: grid; gap: 10px; justify-items: start; margin: 0; }
  .portrait :global(img) { width: min(300px, 72vw); height: auto; }
  figcaption { font-family: var(--mono); font-size: 12px; color: var(--brume); }
  .sommaire { width: 100%; border-top: 1px solid var(--bleu); margin-top: 8px; }
  .sommaire a {
    display: grid; grid-template-columns: 2.2em minmax(0, 1fr) auto; gap: 8px; align-items: baseline;
    padding-block: 10px; border-bottom: 1px solid var(--bleu); text-decoration: none; font-size: 15px;
  }
  .sommaire a span:first-child, .sommaire a span:last-child { font-family: var(--mono); font-size: 12px; color: var(--brume); }
  .sommaire a:hover span:nth-child(2) { color: var(--orange); }
</style>
